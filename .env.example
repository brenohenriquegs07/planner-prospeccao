# Copie para .env (que não vai para o git) e preencha.

# Token de longa duração do Instagram (Instagram API com Instagram Login). Vale 60 dias.
IG_ACCESS_TOKEN=

# ID numérico da conta profissional do Instagram
IG_USER_ID=

# Endereço público onde a pasta export/ está publicada (GitHub Pages), sem barra no fim.
# Ex.: https://brenohenriquegs07.github.io/planner-prospeccao
PUBLIC_BASE_URL=

# Opcionais
# IG_API_URL=https://graph.instagram.com/v26.0
# TOLERANCIA_HORAS=6
